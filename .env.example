# FRED API 키 (무료 발급: https://fredaccount.stlouisfed.org/apikeys)
# 설정하면 CPI / 근원 CPI / PCE / 기준금리 / 고용 / 발표일정이 활성화됩니다.
FRED_API_KEY=

# 한국은행 ECOS API 키 (무료 발급: https://ecos.bok.or.kr/api/#/AuthKeyApply)
# 설정하면 한국 기준금리 / 국고채 / 소비자물가가 활성화됩니다.
ECOS_API_KEY=

# --- 텔레그램 봇 (선택) ---
# 1) 텔레그램에서 @BotFather 에게 /newbot 을 보내 봇을 만들고 받은 토큰을 넣으세요.
TELEGRAM_BOT_TOKEN=
# 2) 만든 봇과의 대화창에 아무 메시지나 보낸 뒤
#    python run.py --telegram-setup  을 실행하면 chat_id 를 찾아줍니다.
TELEGRAM_CHAT_ID=
# 아침 브리핑 발송 시각 (Asia/Seoul)
BRIEF_TIME=07:30
# 0 이면 브리핑 발송 안 함
ENABLE_TELEGRAM=1
# 발표 즉시 알림. 클라우드(GitHub Actions)가 발송을 맡으면 로컬에서는
# 두 스위치를 모두 0 으로 두세요 — 안 그러면 같은 메시지가 두 번 갑니다.
ENABLE_ALERTS=1

# 서버
# 0.0.0.0 = 같은 Wi-Fi 의 다른 기기(휴대폰)에서도 접속 가능
# 127.0.0.1 = 이 PC 에서만 접속 가능
HOST=0.0.0.0
# 8000 은 다른 프로젝트가 쓰고 있어 8500 을 씁니다
PORT=8500

# 브리핑에 넣을 대시보드 주소. 비워두면 LAN IP 로 자동 구성합니다.
# 외부에서 열리는 공유용 스냅샷 주소
SNAPSHOT_URL=
DASHBOARD_URL=

# 스케줄러 자동 실행 (0 이면 수동 수집만)
ENABLE_SCHEDULER=1

# --- 연준 회의록 한글 요약 (선택) ---
# https://console.anthropic.com 에서 발급.
# 없으면 회의록 원문만 수집하고, 나중에 키를 넣으면 소급해서 요약합니다.
ANTHROPIC_API_KEY=
TRANSLATE_MODEL=claude-opus-5

